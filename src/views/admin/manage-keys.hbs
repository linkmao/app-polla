<div class="container mt-5">
    <h2 class="text-white fw-bold mb-4">Gestionar Llaves de Registro</h2>

    {{>mensajes}}

    <div class="row">
        <!-- Formulario para agregar llave -->
        <div class="col-md-4">
            <div class="card bg-dark text-white border-info mb-4 shadow-sm">
                <div class="card-header border-info">
                    <h5 class="mb-0">Generar Nueva Llave</h5>
                </div>
                <div class="card-body">
                    <form action="/api/keys" method="POST">
                        <div class="mb-3">
                            <label for="keyNumber" class="form-label">Número de Llave</label>
                            <input type="number" name="keyNumber" id="keyNumber" class="form-control bg-light text-dark"
                                placeholder="Ej: 101" required>
                        </div>
                        <div class="mb-3">
                            <label for="keyCode" class="form-label">Código (Key Code)</label>
                            <input type="text" name="keyCode" id="keyCode" class="form-control bg-light text-dark"
                                placeholder="Ej: ABC-123" required>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-info">Crear Llave</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Listado de llaves -->
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4">No.</th>
                                    <th>Código</th>
                                    <th>Estado</th>
                                    <th>Usuario ID</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each keys}}
                                <tr>
                                    <td class="ps-4 fw-bold">{{keyNumber}}</td>
                                    <td><code>{{keyCode}}</code></td>
                                    <td>
                                        {{#if isUsed}}
                                        <span class="badge bg-secondary">Usada</span>
                                        {{else}}
                                        <span class="badge bg-success">Disponible</span>
                                        {{/if}}
                                    </td>
                                    <td class="text-muted small">{{#if idUser}}{{idUser}}{{else}}-{{/if}}</td>
                                    <td class="text-center">
                                        {{#unless isUsed}}
                                        <form action="/api/keys/{{_id}}?_method=DELETE" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('¿Estás seguro de eliminar esta llave?')">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                        {{else}}
                                        <button class="btn btn-sm btn-outline-secondary disabled"
                                            title="No se puede borrar una llave ya usada">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                        {{/unless}}
                                    </td>
                                </tr>
                                {{/each}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="/routegames" class="btn btn-outline-light">
            <i class="fas fa-arrow-left me-2"></i>Volver al Panel Principal
        </a>
    </div>
</div>