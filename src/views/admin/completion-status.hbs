<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-12">
      <div class="card bg-dark text-white border-info shadow-lg">
        <div class="card-header border-info text-center py-4">
          <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
            style="width: 60px; height: 60px;">
            <img src="/img/iconos/profile.png" alt="Usuarios" style="width: 35px;">
          </div>
          <h3 class="fw-bold mb-0 text-info">Estado de Diligenciamiento de Jugadores</h3>
        </div>
        <div class="card-body p-4">
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
              <thead class="bg-info bg-opacity-10 text-info">
                <tr>
                  <th>Jugador</th>
                  <th>Email</th>
                  <th class="text-center">Juegos Grupo</th>
                  <th class="text-center">Clasif. Grupo</th>
                  <th class="text-center">Juegos Fases</th>
                  <th class="text-center">Clasif. Final</th>
                </tr>
              </thead>
              <tbody id="completion-status-body">
                <!-- Aquí se llenará dinámicamente con JS -->
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
async function fetchCompletionStatus() {
  const res = await fetch('/api/admin/completion-status');
  const data = await res.json();
  const tbody = document.getElementById('completion-status-body');
  tbody.innerHTML = '';
  data.forEach(row => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td>${row.user.name} ${row.user.lastName}</td>
      <td>${row.user.email}</td>
      <td class="text-center">${row.missingGamesGroups === 0 ? '<span class=\'badge bg-success\'>OK</span>' : `<span class=\'badge bg-danger\'>${row.missingGamesGroups} faltan</span>`}</td>
      <td class="text-center">${row.missingClassGroups === 0 ? '<span class=\'badge bg-success\'>OK</span>' : `<span class=\'badge bg-danger\'>${row.missingClassGroups} faltan</span>`}</td>
      <td class="text-center">${row.missingGamesPhases === 0 ? '<span class=\'badge bg-success\'>OK</span>' : `<span class=\'badge bg-danger\'>${row.missingGamesPhases} faltan</span>`}</td>
      <td class="text-center">${row.missingClassFinal === 0 ? '<span class=\'badge bg-success\'>OK</span>' : `<span class=\'badge bg-danger\'>${row.missingClassFinal} faltan</span>`}</td>
    `;
    tbody.appendChild(tr);
  });
}
fetchCompletionStatus();
</script>
