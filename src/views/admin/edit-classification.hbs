<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card bg-dark text-white rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="card-header bg-warning bg-opacity-10 border-bottom border-warning border-opacity-25 text-center py-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                        style="width: 60px; height: 60px;">
                        <i class="fas fa-trophy text-warning fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-warning">Editar Clasificación</h3>
                    <p class="text-muted small mb-0 uppercase tracking-wider">Ajusta el ranking del grupo <span class="fw-bold">{{classification.group}}</span></p>
                </div>
                <div class="card-body p-4 p-md-5">
                    {{>mensajes}}
                    <form action="/api/classifications/{{classification._id}}?_method=PUT" method="POST">
                        <div class="mb-4">
                            <label for="group" class="form-label fw-bold text-warning small uppercase tracking-wider">Grupo de Competencia</label>
                            <select name="group" id="group" class="form-select bg-light text-dark border-0 py-2 fw-bold" required>
                                {{#each groups}}
                                <option value="{{this}}" {{#if (eq this ../classification.group)}}selected{{/if}}>Grupo {{this}}</option>
                                {{/each}}
                            </select>
                        </div>

                        <div class="container mt-5">
                            <div class="row justify-content-center">
                                <div class="col-md-7">
                                    <div class="card bg-dark text-white shadow-lg">
                                        <div class="card-header border-bottom border-secondary">
                                            <h3 class="text-center mb-0">Editar Clasificación</h3>
                                        </div>
                                        <div class="card-body p-4">
                                            {{>mensajes}}
                                            <form action="/api/classifications/{{classification._id}}?_method=PUT" method="POST">
                                                <div class="mb-4">
                                                    <label for="group" class="form-label fw-bold text-primary small uppercase tracking-wider">Grupo de Competencia</label>
                                                    <select name="group" id="group" class="form-select bg-light text-dark border-0 py-2 fw-bold" required>
                                                        {{#each groups}}
                                                        <option value="{{this}}" {{#if (eq this ../classification.group)}}selected{{/if}}>Grupo {{this}}</option>
                                                        {{/each}}
                                                    </select>
                                                </div>
                                                <hr class="border-secondary opacity-25 my-4">
                                                <div class="row g-3 mb-4">
                                                    <div class="col-md-6">
                                                        <label for="firstTeam" class="form-label fw-bold text-success small uppercase">1° Puesto (Ganador)</label>
                                                        <select name="firstTeam" id="firstTeam" class="form-select team-select bg-light text-dark border-0 py-2" required>
                                                            <option value="Generic Team" data-group="all" {{#if (eq classification.firstTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                                                            {{#each teams}}
                                                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.firstTeam)}}selected{{/if}}>{{name}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label for="secondTeam" class="form-label fw-bold text-info small uppercase">2° Puesto</label>
                                                        <select name="secondTeam" id="secondTeam" class="form-select team-select bg-light text-dark border-0 py-2" required>
                                                            <option value="Generic Team" data-group="all" {{#if (eq classification.secondTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                                                            {{#each teams}}
                                                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.secondTeam)}}selected{{/if}}>{{name}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6 mt-4">
                                                        <label for="thirdTeam" class="form-label fw-bold text-warning small uppercase">3° Puesto</label>
                                                        <select name="thirdTeam" id="thirdTeam" class="form-select team-select bg-light text-dark border-0 py-2" required>
                                                            <option value="Generic Team" data-group="all" {{#if (eq classification.thirdTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                                                            {{#each teams}}
                                                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.thirdTeam)}}selected{{/if}}>{{name}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </div>
                                                    <div class="col-md-6 mt-4">
                                                        <label for="fourthTeam" class="form-label fw-bold text-secondary small uppercase">4° Puesto</label>
                                                        <select name="fourthTeam" id="fourthTeam" class="form-select team-select bg-light text-dark border-0 py-2" required>
                                                            <option value="Generic Team" data-group="all" {{#if (eq classification.fourthTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                                                            {{#each teams}}
                                                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.fourthTeam)}}selected{{/if}}>{{name}}</option>
                                                            {{/each}}
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="d-grid gap-2">
                                                    <button type="submit" class="btn btn-primary btn-lg">Guardar Cambios</button>
                                                    <a href="/admin/classifications" class="btn btn-outline-light">Volver a Clasificaciones</a>
                                                    <a href="/routegames" class="btn btn-outline-secondary text-white">Panel</a>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
 

</script>

<style>
    .smaller { font-size: 0.75rem; }
    .uppercase { text-transform: uppercase; }
    .tracking-wider { letter-spacing: 0.1em; }
    .card { transition: transform 0.3s ease; }
    .card:hover { transform: translateY(-5px); }
</style>
