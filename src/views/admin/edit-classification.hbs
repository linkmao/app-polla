<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-warning fw-bold mb-0">Editar Clasificación</h2>
    </div>

    {{>mensajes}}

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form action="/api/classifications/{{classification._id}}?_method=PUT" method="POST">
                <div class="mb-4">
                    <label for="group" class="form-label fw-bold">Grupo de Competencia</label>
                    <select name="group" id="group" class="form-select bg-light" required>
                        {{#each groups}}
                        <option value="{{this}}" {{#if (eq this ../classification.group)}}selected{{/if}}>Grupo {{this}}</option>
                        {{/each}}
                    </select>
                </div>
                <hr class="border-secondary opacity-25 my-4">
                <div class="row g-3 mb-4">
                    <div class="col-md-6 mb-3">
                        <label for="firstTeam" class="form-label fw-bold text-success small text-uppercase">1° Puesto (Ganador)</label>
                        <select name="firstTeam" id="firstTeam" class="form-select team-select" required>
                            <option value="Generic Team" data-group="all" {{#if (eq classification.firstTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                            {{#each teams}}
                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.firstTeam)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="secondTeam" class="form-label fw-bold text-info small text-uppercase">2° Puesto</label>
                        <select name="secondTeam" id="secondTeam" class="form-select team-select" required>
                            <option value="Generic Team" data-group="all" {{#if (eq classification.secondTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                            {{#each teams}}
                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.secondTeam)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="thirdTeam" class="form-label fw-bold text-warning small text-uppercase">3° Puesto</label>
                        <select name="thirdTeam" id="thirdTeam" class="form-select team-select" required>
                            <option value="Generic Team" data-group="all" {{#if (eq classification.thirdTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                            {{#each teams}}
                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.thirdTeam)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="fourthTeam" class="form-label fw-bold text-secondary small text-uppercase">4° Puesto</label>
                        <select name="fourthTeam" id="fourthTeam" class="form-select team-select" required>
                            <option value="Generic Team" data-group="all" {{#if (eq classification.fourthTeam "Generic Team")}}selected{{/if}}>Generic Team</option>
                            {{#each teams}}
                            <option value="{{_id}}" data-group="{{group}}" {{#if (eq _id ../classification.fourthTeam)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-warning px-4 text-white hover-shadow">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <a href="/admin/classifications" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver al Listado
        </a>
    </div>
</div>
