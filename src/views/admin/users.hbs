<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div class="card bg-dark text-white border-info shadow-lg">
        <div class="card-header border-info text-center py-4">
          <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
            style="width: 60px; height: 60px;">
            <img src="/img/iconos/profile.png" alt="Usuarios" style="width: 35px;">
          </div>
          <h3 class="fw-bold mb-0 text-info">Gestión de Usuarios</h3>
        </div>
        <div class="card-body p-4 text-center">
          <p class="text-muted mb-4">Haz clic en el botón para consultar el listado completo de jugadores registrados en
            el sistema.</p>

          <form action="/api/users" method="GET" class="mb-4">
            <div class="d-grid">
              <button type="submit" class="btn btn-info btn-lg text-white fw-bold shadow-sm">
                <i class="fas fa-users me-2"></i>Obtener Listado de Usuarios
              </button>
            </div>
          </form>

          <hr class="border-secondary opacity-25">

          <a href="/routegames" class="btn btn-outline-light w-100">
            <i class="fas fa-arrow-left me-2"></i>Volver al Panel Principal
          </a>
        </div>
      </div>
    </div>
  </div>
</div>