<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="text-primary fw-bold mb-0">Editar Equipo</h2>
    </div>

    {{>mensajes}}

    <style>
        .form-label {
            font-weight: 700;
        }
    </style>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form action="/api/teams/{{team._id}}?_method=PUT" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="name" class="form-label">Nombre del Equipo</label>
                    <input type="text" name="name" id="name" class="form-control" value="{{team.name}}" required autofocus>
                </div>
                <div class="mb-3">
                    <label for="group" class="form-label">Grupo</label>
                    <input type="text" name="group" id="group" class="form-control" value="{{team.group}}" required>
                </div>
                <div class="mb-3">
                    <label for="tag" class="form-label">Etiqueta (Tag)</label>
                    <input type="text" name="tag" id="tag" class="form-control" value="{{team.tag}}" placeholder="Ej: A1, B2">
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Bandera Actual</label>
                    <div class="d-flex align-items-center bg-light p-3 rounded-3 border">
                        <img src="/img/flags/{{team.flag}}" alt="{{team.name}}" class="img-thumbnail border-0 shadow-sm me-3" style="width: 80px; height: 60px; object-fit: cover;">
                        <div>
                            <p class="mb-1 fw-bold small text-dark">Archivo: {{team.flag}}</p>
                            <p class="mb-0 text-muted small text-uppercase" style="font-size: 0.75rem;">Imagen en servidor</p>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="flag" class="form-label">Cambiar Bandera</label>
                    <input type="file" name="flag" id="flag" class="form-control" accept="image/*">
                    <div class="form-text text-muted small mt-2">Sube una nueva imagen (PNG/JPG) para reemplazar la actual.</div>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>

    <div class="mt-4">
        <a href="/admin/teams" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver al Listado
        </a>
    </div>
</div>