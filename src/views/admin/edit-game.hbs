<div class="container mt-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success fw-bold mb-0">Editar Juego (Partido)</h2>
    </div>

    {{>mensajes}}

    <style>
        #form label {
            font-weight: 700;
        }
        .highlight-field {
            background-color: #d4edda;
            color: #0c3e1d;
            border-color: #9ccf9f;
        }
        #form input.form-control,
        #form select.form-select {
            background-color: #ffffff;
            color: #212529;
            border-color: #ced4da;
        }
        [data-bs-theme="dark"] #form input.form-control,
        [data-bs-theme="dark"] #form select.form-select {
            background-color: #343a40;
            color: #f8f9fa;
            border-color: #495057;
        }
        [data-bs-theme="dark"] #form .highlight-field {
            background-color: #1d4d37;
            color: #e3f7e8;
            border-color: #3b8261;
        }
    </style>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4 p-md-5">
            <form action="/api/games/{{game._id}}?_method=PUT" method="POST" id="form">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="gameNumber" class="form-label">Número de Juego</label>
                        <input type="number" name="gameNumber" id="gameNumber"
                            class="form-control highlight-field" value="{{game.gameNumber}}" required
                            readonly>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="phase" class="form-label">Fase (Número)</label>
                        <select name="phase" id="phase" class="form-select" required>
                            <option value="1" {{#if (eq game.phase 1)}}selected{{/if}}>1 - Ronda de Grupos</option>
                            <option value="2" {{#if (eq game.phase 2)}}selected{{/if}}>2 - 16 avo de Final</option>
                            <option value="3" {{#if (eq game.phase 3)}}selected{{/if}}>3 - Octavos de Final</option>
                            <option value="4" {{#if (eq game.phase 4)}}selected{{/if}}>4 - Cuartos de Final</option>
                            <option value="5" {{#if (eq game.phase 5)}}selected{{/if}}>5 - Semifinal</option>
                            <option value="6" {{#if (eq game.phase 6)}}selected{{/if}}>6 - Final / 3er Puesto</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="localTeam" class="form-label">Equipo Local</label>
                        <select name="localTeam" id="localTeam" class="form-select" required>
                            <option value="GENERIC LOCAL TEAM">Genérico (Para Fases)</option>
                            {{#each teams}}
                            <option id="localTeam" value="{{_id}}" {{#if (eq ../game.localTeam _id)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="visitTeam" class="form-label">Equipo Visitante</label>
                        <select name="visitTeam" id="visitTeam" class="form-select" required>
                            <option value="GENERIC VISIT TEAM">Genérico (Para Fases)</option>
                            {{#each teams}}
                            <option id="visitTeam" value="{{_id}}" {{#if (eq ../game.visitTeam _id)}}selected{{/if}}>{{name}}</option>
                            {{/each}}
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label for="localScore" class="form-label">Goles Local</label>
                        <input type="number" name="localScore" id="localScore"
                            class="form-control highlight-field" value="{{game.localScore}}">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="visitScore" class="form-label">Goles Visitante</label>
                        <input type="number" name="visitScore" id="visitScore"
                            class="form-control highlight-field" value="{{game.visitScore}}">
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="analogScore" class="form-label">Analog (L/E/V)</label>
                        <select name="analogScore" id="analogScore" class="form-select highlight-field">
                            <option value="L" {{#if (eq game.analogScore 'L')}}selected{{/if}}>L</option>
                            <option value="E" {{#if (eq game.analogScore 'E')}}selected{{/if}}>E</option>
                            <option value="V" {{#if (eq game.analogScore 'V')}}selected{{/if}}>V</option>
                            <option value="-1" {{#if (eq game.analogScore '-1')}}selected{{/if}}>-1</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="dateGame" class="form-label">Fecha del Juego</label>
                        <input type="date" name="dateGame" id="dateGame" class="form-control"
                            value="{{game.dateGame}}" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="hourGame" class="form-label">Hora del Juego</label>
                        <input type="time" name="hourGame" id="hourGame" class="form-control"
                            value="{{game.hourGame}}" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="group" class="form-label">Grupo del Partido</label>
                    <input type="text" name="group" id="group" class="form-control"
                        value="{{game.group}}" required>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Descripción</label>
                    <input type="text" name="description" id="description"
                        class="form-control" value="{{game.description}}" required>
                </div>

                <div class="form-check mb-4 mt-4">
                    <input class="form-check-input" type="checkbox" name="forCalculate" id="forCalculate"
                        value="true">
                    <label class="form-check-label text-muted" for="forCalculate">
                        ¿Calcular puntajes de apostadores? (Solo si el partido ya terminó)
                    </label>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success px-4 mb-3">Guardar Cambios</button>
                </div>
            </form>

            <form id="notification" class="mt-3">
                <button type="submit" class="btn btn-primary">Enviar Notificación</button>
            </form>
        </div>
    </div>


    <div class="mt-2">
        <a href="/admin/games" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver al Listado
        </a>
    </div>
</div>

<script>
    const form=document.getElementById('notification')
    const localTeam=document.getElementById('localTeam').options[document.getElementById('localTeam').selectedIndex].text
    const visitTeam=document.getElementById('visitTeam').options[document.getElementById('visitTeam').selectedIndex].text
    const mensaje= 'El partido entre ' + localTeam + ' y ' + visitTeam + ' ha sido actualizado. ¡Revisa los nuevos resultados!'

    form.addEventListener('submit',  e=>{
     
     e.preventDefault()
     
     console.log('preparando el terreno')
     console.log('enviando notificacion')
        fetch('/api/notification/send-notification', {
        method: 'POST',
        headers: {
            "Content-Type": "application/json"
        },
        body: JSON.stringify({
            title: 'Polla mundialista 2026',
            message: mensaje
        })
        }
    )}
    
    )
   
</script>