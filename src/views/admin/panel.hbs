<div class="container mt-5">
    <div
        class="d-flex justify-content-between align-items-center mb-5 bg-dark p-4 rounded-3 shadow-sm border-bottom border-primary">
        <div>
            <h1 class="text-white fw-bold mb-0">Panel de Administración</h1>
            <p class="text-primary mb-0 small uppercase tracking-wider">Control Maestro del Torneo</p>
        </div>
        <a href="/auth/logout" class="btn btn-outline-danger px-4">
            <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
        </a>
    </div>

    {{>mensajes}}
    <div class="row g-4 justify-content-center">
        <!-- Gestión de Equipos -->
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <img src="/img/iconos/game-by-group.png" alt="Equipos" style="width: 45px;">
                    </div>
                    <h3 class="card-title h4 mb-3">Equipos</h3>
                    <p class="card-text text-muted mb-4">Registra nuevos equipos y gestiona los participantes del
                        torneo.</p>
                    <div class="d-grid">
                        <a href="/admin/teams" class="btn btn-primary btn-lg">Gestionar Equipos</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gestión de Juegos -->
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all">
                <div class="card-body text-center p-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <img src="/img/iconos/game-by-phase.png" alt="Juegos" style="width: 45px;">
                    </div>
                    <h3 class="card-title h4 mb-3">Juegos y Partidos</h3>
                    <p class="card-text text-muted mb-4">Define el fixture, asigna estadios y configura las fechas de
                        juego.</p>
                    <div class="d-grid">
                        <a href="/admin/games" class="btn btn-success btn-lg">Gestionar Juegos</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gestión de Usuarios -->
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all border-bottom border-info border-3">
                <div class="card-body text-center p-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <img src="/img/iconos/profile.png" alt="Usuarios" style="width: 45px;">
                    </div>
                    <h3 class="card-title h4 mb-3">Usuarios</h3>
                    <p class="card-text text-muted mb-4">Gestiona a los jugadores: actualiza sus datos, contraseñas o gestiona llaves de acceso.</p>
                    <div class="d-grid gap-2">
                        <a href="/admin/users" class="btn btn-info btn-lg text-white">Gestionar Usuarios</a>
                        <a href="/admin/keys" class="btn btn-outline-info">Gestionar Llaves</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Seguridad -->
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <img src="/img/iconos/point.png" alt="Puntajes" style="width: 45px;">
                    </div>
                    <h3 class="card-title h4 mb-3">Seguridad</h3>
                    <p class="card-text text-muted mb-4">Restablecer contraseñas y gestionar accesos administrativos.
                    </p>
                    <div class="d-grid">
                        <a href="/admin/pass-restore" class="btn btn-warning text-white">Restablecer Password</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Clasificaciones -->
        <div class="col-md-5">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all border-bottom border-primary border-3">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <i class="fas fa-trophy text-primary fs-2"></i>
                    </div>
                    <h3 class="card-title h4 mb-3">Clasificaciones</h3>
                    <p class="card-text text-muted mb-4">Define los rankings oficiales de cada grupo para calcular los puntos de los jugadores.</p>
                    <div class="d-grid">
                        <a href="/admin/classifications" class="btn btn-primary btn-lg">Gestionar Clasificaciones</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Estado de Diligenciamiento de Jugadores -->
        <div class="col-md-12">
            <div class="card h-100 border-0 shadow-sm hover-shadow transition-all border-bottom border-info border-3">
                <div class="card-body text-center p-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                        style="width: 80px; height: 80px;">
                        <i class="fas fa-tasks text-info fs-2"></i>
                    </div>
                    <h3 class="card-title h4 mb-3">Estado de Diligenciamiento</h3>
                    <p class="card-text text-muted mb-4">Consulta qué jugadores han diligenciado o no sus apuestas y clasificaciones.</p>
                    <div class="d-grid">
                        <a href="/admin/completion-status" class="btn btn-info btn-lg">Ver Estado de Diligenciamiento</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <!-- Actualizar Puntajes -->
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm hover-shadow transition-all border-bottom border-success border-3">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                    style="width: 80px; height: 80px;">
                    <i class="fas fa-sync-alt text-success fs-2"></i>
                </div>
                <h3 class="card-title h4 mb-3">Actualizar Puntajes</h3>
                <p class="card-text text-muted mb-4">Actualiza los puntajes de todos los jugadores según los resultados más recientes.</p>
                <div class="d-grid">
                    <button id="btn-update-point" class="btn btn-success btn-lg">Actualizar Puntajes</button>
                </div>
                <div id="update-point-message" class="alert alert-success mt-3 d-none" role="alert">
                    Puntajes actualizados correctamente.
                </div>
            </div>
        </div>
    </div>

    <!-- Configuración del Sistema -->
    <div class="col-md-6">
        <div class="card h-100 border-0 shadow-sm hover-shadow transition-all border-bottom border-primary border-3">
            <div class="card-body text-center p-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-4"
                    style="width: 80px; height: 80px;">
                    <i class="fas fa-cogs text-primary fs-2"></i>
                </div>
                <h3 class="card-title h4 mb-3">Configuración</h3>
                <p class="card-text text-muted mb-4">Gestiona puntajes, fechas y parámetros globales del sistema desde una interfaz centralizada.</p>
                <div class="d-grid">
                    <a href="/admin/config" class="btn btn-primary btn-lg">Gestionar Sistema</a>
                </div>
            </div>
        </div>
    </div>

<style>
    .hover-shadow:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, .175) !important;
    }

    .transition-all {
        transition: all 0.3s ease-in-out;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btnUpdate = document.getElementById('btn-update-point');
        const msg = document.getElementById('update-point-message');
        if (btnUpdate) {
            btnUpdate.addEventListener('click', async function () {
                btnUpdate.disabled = true;
                btnUpdate.textContent = 'Actualizando...';
                try {
                    const res = await fetch('/updatepoint');
                    if (res.ok) {
                        msg.classList.remove('d-none');
                        setTimeout(() => { msg.classList.add('d-none'); }, 3000);
                    } else {
                        alert('Error al actualizar puntajes');
                    }
                } catch (e) {
                    alert('Error de red al actualizar puntajes');
                }
                btnUpdate.disabled = false;
                btnUpdate.textContent = 'Actualizar Puntajes';
            });
        }
    });
</script>