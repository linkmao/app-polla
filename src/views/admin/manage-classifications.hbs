<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-primary border-opacity-25">
        <div>
            <h2 class="text-primary fw-bold mb-0">Gestionar Clasificaciones</h2>
            <p class="text-muted small mb-0 uppercase tracking-wider">Definición de posiciones por grupo</p>
        </div>
        <a href="/admin/classifications/add" class="btn btn-primary px-4 shadow-sm">
            <i class="fas fa-plus me-2"></i>Agregar Clasificación
        </a>
    </div>

    {{>mensajes}}

    <div class="card border-0 shadow-lg bg-dark text-white rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="bg-primary bg-opacity-10 text-primary border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4 py-3">Grupo</th>
                            <th class="py-3">1° Puesto</th>
                            <th class="py-3">2° Puesto</th>
                            <th class="py-3">3° Puesto</th>
                            <th class="py-3">4° Puesto</th>
                            <th class="text-center py-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each classifications}}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="ps-4 fw-bold text-primary">{{group}}</td>
                            <td><span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 fw-normal px-2 py-1">{{firstTeamName}}</span></td>
                            <td><span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 fw-normal px-2 py-1">{{secondTeamName}}</span></td>
                            <td><span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 fw-normal px-2 py-1">{{thirdTeamName}}</span></td>
                            <td><span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 fw-normal px-2 py-1">{{fourthTeamName}}</span></td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                                                        <a href="/admin/classifications/edit/{{_id}}" class="btn btn-sm btn-outline-primary border-0" style="font-weight:bold; color:#0d6efd;">
                                                                                Editar
                                                                        </a>
                                                                        <button type="button" class="btn btn-sm btn-outline-danger border-0" style="font-weight:bold; color:#dc3545;" data-bs-toggle="modal" data-bs-target="#deleteModal-{{_id}}">
                                                                                Eliminar
                                                                        </button>
                                                                        <!-- Modal de confirmación de eliminación -->
                                                                        <div class="modal fade" id="deleteModal-{{_id}}" tabindex="-1" aria-labelledby="deleteModalLabel-{{_id}}" aria-hidden="true">
                                                                            <div class="modal-dialog modal-dialog-centered">
                                                                                <div class="modal-content bg-dark text-white">
                                                                                    <div class="modal-header border-0">
                                                                                        <h5 class="modal-title" id="deleteModalLabel-{{_id}}">Confirmar eliminación</h5>
                                                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                                                                                    </div>
                                                                                    <div class="modal-body">
                                                                                        ¿Estás seguro de que deseas eliminar esta clasificación del grupo <span class="fw-bold text-primary">{{group}}</span>?
                                                                                    </div>
                                                                                    <div class="modal-footer border-0">
                                                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                                                                                        <form action="/api/classifications/{{_id}}?_method=DELETE" method="POST" style="display:inline;">
                                                                                            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                                                                                        </form>
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                </div>
                            </td>
                        </tr>
                        {{else}}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-info-circle me-2"></i>No hay clasificaciones registradas aún.
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex justify-content-between">
        <a href="/routegames" class="btn btn-outline-secondary border-0">
            <i class="fas fa-arrow-left me-2"></i>Volver al Panel
        </a>
        <form action="/api/classifications/reset-classification?_method=PUT" method="POST">
            <button type="submit" class="btn btn-outline-warning border-0" onclick="return confirm('¿Restablecer TODAS las clasificaciones? No se pueden deshacer los cambios.')">
                <i class="fas fa-sync-alt me-2"></i>Restablecer Todo
            </button>
        </form>
    </div>
</div>

<style>
    .uppercase { text-transform: uppercase; }
    .tracking-wider { letter-spacing: 0.1em; }
    .table-hover tbody tr:hover { background-color: rgba(255,255,255,0.03) !important; transition: 0.3s; }
    .badge { font-size: 0.85rem; }
</style>
