<!-- Dashboard de Cuentas Regresivas -->
<div class="countdown-dashboard">
    <!-- Contador: Inicio del Torneo -->
    {{#if viewInitDateTournament}}
    <div class="card mb-3 border-0 shadow-sm overflow-hidden" style="border-radius: 12px; background: linear-gradient(135deg, #1a2a6c, #243b55);">
        <div class="card-body p-3 text-white">
            <h6 class="text-uppercase fw-bold mb-0 small" style="letter-spacing: 1px;">
                <i class="fas fa-trophy me-2 text-warning"></i>Inicio del Mundial
            </h6>
            <div class="small opacity-75 mb-2" style="font-size: 0.7rem;">{{initDateTournament}}</div>
            <div id="tournament-timer" class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    <div class="timer-unit"><span id="days-t">00</span><small>D</small></div>
                    <div class="timer-unit"><span id="hours-t">00</span><small>H</small></div>
                    <div class="timer-unit"><span id="minutes-t">00</span><small>M</small></div>
                    <div class="timer-unit text-warning"><span id="seconds-t">00</span><small>S</small></div>
                </div>
                <div id="t-started" class="d-none"><span class="badge bg-success">¡EN MARCHA!</span></div>
            </div>
        </div>
    </div>
    {{/if}}

    <!-- Contador: Cierre Apuestas Grupos -->
    {{#if viewCloseBetGroups}}
    <div class="card mb-3 border-0 shadow-sm overflow-hidden" style="border-radius: 12px; background: linear-gradient(135deg, #b21f1f, #8e0e00);">
        <div class="card-body p-3 text-white">
            <h6 class="text-uppercase fw-bold mb-0 small" style="letter-spacing: 1px;">
                <i class="fas fa-clock me-2 text-warning"></i>Cierre Apuestas Grupos
            </h6>
            <div class="small opacity-75 mb-2" style="font-size: 0.7rem;">{{closeBetGroups}}</div>
            <div id="groups-timer" class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    <div class="timer-unit"><span id="days-g">00</span><small>D</small></div>
                    <div class="timer-unit"><span id="hours-g">00</span><small>H</small></div>
                    <div class="timer-unit"><span id="minutes-g">00</span><small>M</small></div>
                    <div class="timer-unit text-warning"><span id="seconds-g">00</span><small>S</small></div>
                </div>
                <div id="g-closed" class="d-none"><span class="badge bg-secondary">CERRADAS</span></div>
            </div>
        </div>
    </div>
    {{/if}}

    <!-- Contador: Cierre Apuestas Fases -->
    {{#if viewCloseBetPhases}}
    <div class="card mb-4 border-0 shadow-sm overflow-hidden" style="border-radius: 12px; background: linear-gradient(135deg, #fdbb2d, #22c1c3);">
        <div class="card-body p-3 text-dark">
            <h6 class="text-uppercase fw-bold mb-0 small" style="letter-spacing: 1px;">
                <i class="fas fa-hourglass-end me-2 text-danger"></i>Cierre Apuestas Fases
            </h6>
            <div class="small opacity-75 mb-2" style="font-size: 0.7rem;">{{closeBetPhases}}</div>
            <div id="phases-timer" class="d-flex justify-content-between align-items-center">
                <div class="d-flex gap-2">
                    <div class="timer-unit dark"><span id="days-p">00</span><small>D</small></div>
                    <div class="timer-unit dark"><span id="hours-p">00</span><small>H</small></div>
                    <div class="timer-unit dark"><span id="minutes-p">00</span><small>M</small></div>
                    <div class="timer-unit text-danger"><span id="seconds-p">00</span><small>S</small></div>
                </div>
                <div id="p-closed" class="d-none"><span class="badge bg-secondary">CERRADAS</span></div>
            </div>
        </div>
    </div>
    {{/if}}
</div>

<style>
    .timer-unit {
        background: rgba(255, 255, 255, 0.15);
        padding: 5px 10px;
        border-radius: 6px;
        font-weight: bold;
        min-width: 55px;
        display: flex;
        flex-direction: column;
        align-items: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .timer-unit.dark {
        background: rgba(0, 0, 0, 0.1);
        border: 1px solid rgba(0, 0, 0, 0.1);
    }
    .timer-unit small {
        font-size: 0.65rem;
        opacity: 0.7;
        margin-top: -2px;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const timers = [
            { id: 't', date: "{{initDateTournament}}", container: 'tournament-timer', msg: 't-started' },
            { id: 'g', date: "{{closeBetGroups}}", container: 'groups-timer', msg: 'g-closed' },
            { id: 'p', date: "{{closeBetPhases}}", container: 'phases-timer', msg: 'p-closed' }
        ];

        const updateAll = () => {
            const now = new Date().getTime();

            timers.forEach(t => {
                if (!t.date) return;
                const target = new Date(t.date).getTime();
                const diff = target - now;

                if (diff < 0) {
                    const timerEl = document.getElementById(t.container);
                    const msgEl = document.getElementById(t.msg);
                    if (timerEl) timerEl.querySelector('.d-flex').classList.add('d-none');
                    if (msgEl) msgEl.classList.remove('d-none');
                    return;
                }

                const d = Math.floor(diff / (1000 * 60 * 60 * 24));
                const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const s = Math.floor((diff % (1000 * 60)) / 1000);

                const ds = document.getElementById('days-' + t.id);
                const hs = document.getElementById('hours-' + t.id);
                const ms = document.getElementById('minutes-' + t.id);
                const ss = document.getElementById('seconds-' + t.id);

                if (ds) ds.innerText = String(d).padStart(2, '0');
                if (hs) hs.innerText = String(h).padStart(2, '0');
                if (ms) ms.innerText = String(m).padStart(2, '0');
                if (ss) ss.innerText = String(s).padStart(2, '0');
            });
        };

        const interval = setInterval(updateAll, 1000);
        updateAll();
    });
</script>
