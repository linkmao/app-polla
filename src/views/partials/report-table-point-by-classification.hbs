<table class="table">
  {{#each dataFlag}}
  <thead>
    <tr>
      <th scope="col" style="text-align: center">Jugador</th>
      {{#if renderFinal}}
      <th scope="col" style="text-align: center">Campeón</th>
      <th scope="col" style="text-align: center">Sub Campeón</th>
      <th scope="col" style="text-align: center">Tercero</th>
      <th scope="col" style="text-align: center">Cuarto</th>
      <th scope="col" style="text-align: center">Pts campeón</th>
      <th scope="col" style="text-align: center">Pts sub campeó</th>
      <th scope="col" style="text-align: center">Pts tercero</th>
      <th scope="col" style="text-align: center">Pts cuarto</th>
      {{else }}
      <th scope="col" style="text-align: center">Primero</th>
      <th scope="col" style="text-align: center">Segundo</th>
      <th scope="col" style="text-align: center">Tercero</th>
      <th scope="col" style="text-align: center">Cuarto</th>
      <th scope="col" style="text-align: center">Puntos primero</th>
      <th scope="col" style="text-align: center">Puntos segundo</th>
      <th scope="col" style="text-align: center">Puntos tercero</th>
      <th scope="col" style="text-align: center">Puntos cuarto</th>
      {{/if}}
      <th scope="col" style="text-align: center; cursor: pointer;" id="sortTotalHeader">
        TOTAL <span id="sortIcon" style="font-size: 0.8em;">⇅</span>
      </th>
    </tr>
  </thead>
  {{/each}}

  <tbody id="betsBody">
  {{#each dataBetClassification}}
    <tr>
      <td scope="col" style="text-align: center">{{name}}</td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{firstFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{firstTeam}}
          </div>
        </div>
      </td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{secondFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{secondTeam}}
          </div>
        </div>
      </td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{thirdFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{thirdTeam}}
          </div>
        </div>
      </td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{fourthFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{fourthTeam}}
          </div>
        </div>
      </td>
      <td scope="col" style="text-align: center">{{pointByFirst}}</td>
      <td scope="col" style="text-align: center">{{pointBySecond}}</td>
      <td scope="col" style="text-align: center">{{pointByThird}}</td>
      <td scope="col" style="text-align: center">{{pointByFourth}}</td>
      <td scope="col" style="text-align: center">
        {{#if (eq total 0)}}
          <span style="color: red; font-size: 1.0em;">{{total}}</span>
        {{else if (eq total 5)}}
          <span style="color: blue; font-size: 1.1em;">{{total}}</span>
        {{else if (eq total 10)}}
          <span style="color: blue; font-size: 1.1em;">{{total}}</span>
        {{else if (eq total 15)}}
          <span style="color: blue; font-size: 1.1em;">{{total}}</span>
        {{else if (eq total 20)}}
          <span style="color: green; font-weight: bold; font-size: 1.3em;">{{total}}</span>
        {{else}}
          <span style="font-size: 1.0em;">{{total}}</span>
        {{/if}}
      </td>
    </tr>
  {{/each}}
  </tbody>
</table>

<script>
  let isSortedAsc = null; // null = sin ordenar, true = ascendente, false = descendente

  document.getElementById('sortTotalHeader').addEventListener('click', function() {
    const table = this.closest('table');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const sortIcon = document.getElementById('sortIcon');

    if (isSortedAsc === null || isSortedAsc === false) {
      isSortedAsc = true;
      sortIcon.textContent = '▲';
    } else {
      isSortedAsc = false;
      sortIcon.textContent = '▼';
    }

    rows.sort((a, b) => {
      const aValue = parseInt(a.querySelector('td:last-child').textContent.trim()) || 0;
      const bValue = parseInt(b.querySelector('td:last-child').textContent.trim()) || 0;
      return isSortedAsc ? aValue - bValue : bValue - aValue;
    });

    rows.forEach(row => tbody.appendChild(row));
  });
</script>