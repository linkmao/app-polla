{{#each dataGame}}
<div class="card">
  {{!-- <img src="..." class="card-img-top" alt="..."> --}}
  <div class="card-body">
    <h6 class="card-title">Juego número: {{gameNumber}}</h6>
    <div class="row">
      <div class="col">
        <img src="/img/flags/{{localFlag}}" alt="flag" width="100%">
      </div>
      <div class="col">
        <p class="card-text">{{localTeam}}</p>
      </div>
      <div class="col">
        <h2 class="card-text">{{localScore}}</h2>
      </div>
      <div class="col">
        <h2>{{analogScore}}</h2>
      </div>
      <div class="col">
        <h2 class="card-text">{{visitScore}}</h2>
      </div>
      <div class="col">
        <p class="card-text">{{visitTeam}}</p>
      </div>
      <div class="col">
        <img src="/img/flags/{{visitFlag}}" alt="flag" width="100%">
      </div>

    </div>
  </div>
</div>
{{/each}}

<br><br>

<table class="table">
  <thead>
    <tr>
      <th scope="col" style="text-align: center">Pos</th>
      <th scope="col" style="text-align: center">Jugador</th>
      <th scope="col" style="text-align: center">Local apostado</th>
      <th scope="col" style="text-align: center">Visitante apostado</th>
      <th scope="col" style="text-align: center">Local</th>
      <th scope="col" style="text-align: center">L-E-V</th>
      <th scope="col" style="text-align: center">Visitante</th>
      <th scope="col" style="text-align: center">Pts por marcador</th>
      <th scope="col" style="text-align: center">Pts por L-E-V</th>
      <th scope="col" style="text-align: center">Pts por local</th>
      <th scope="col" style="text-align: center">Pts por visitante</th>
      <th scope="col" style="text-align: center; cursor: pointer;" id="sortTotalHeader">
        TOTAL <span id="sortIcon" style="font-size: 0.8em;">⇅</span>
      </th>
    </tr>
  </thead>
  <tbody id="betsBody">
  {{#each dataBet}}
    <tr>
      <td></td>
      <td scope="col" style="text-align: center">{{name}}</td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{localFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{localTeam}}
          </div>
        </div>

      </td>
      <td scope="col" style="text-align: center">
        <div class="row">
          <div class="col">
            <img src="/img/flags/{{visitFlag}}" alt="flag" width="30%">
          </div>
          <div class="col">
            {{visitTeam}}
          </div>
        </div>

      </td>
      <td scope="col" style="text-align: center">{{localScore}}</td>
      <td scope="col" style="text-align: center">{{analogScore}}</td>
      <td scope="col" style="text-align: center">{{visitScore}}</td>
      <td scope="col" style="text-align: center">{{pointByScore}}</td>
      <td scope="col" style="text-align: center">{{pointByAnalogScore}}</td>
      <td scope="col" style="text-align: center">{{pointByLocalEqual}}</td>
      <td scope="col" style="text-align: center">{{pointByVisitEqual}}</td>
      <td scope="col" style="text-align: center">
        {{#if (eq totalByGame 0)}}
          <span style="color: red;">{{totalByGame}}</span>
        {{else if (eq totalByGame 2)}}
          <span style="color: blue; font-size: 1.1em;">{{totalByGame}}</span>
        {{else if (eq totalByGame 3)}}
          <span style="color: blue; font-size: 1.1em;">{{totalByGame}}</span>
        {{else if (eq totalByGame 5)}}
          <span style="color: darkgreen; font-weight: bold; font-size: 1.3em;">{{totalByGame}}</span>
        {{else}}
          {{totalByGame}}
        {{/if}}
      </td>
    </tr>
  {{/each}}
  </tbody>
</table>

<script>
  let isSortedAsc = null; // null = sin ordenar, true = ascendente, false = descendente

  document.getElementById('sortTotalHeader').addEventListener('click', function() {
    const table = this.closest('table');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const sortIcon = document.getElementById('sortIcon');

    if (isSortedAsc === null || isSortedAsc === false) {
      isSortedAsc = true;
      sortIcon.textContent = '▲';
    } else {
      isSortedAsc = false;
      sortIcon.textContent = '▼';
    }

    rows.sort((a, b) => {
      const aCells = a.querySelectorAll('td');
      const bCells = b.querySelectorAll('td');
      const aValue = parseInt(aCells[aCells.length - 1].textContent.trim()) || 0;
      const bValue = parseInt(bCells[bCells.length - 1].textContent.trim()) || 0;
      return isSortedAsc ? aValue - bValue : bValue - aValue;
    });

    rows.forEach(row => tbody.appendChild(row));
  });
</script>