<div class="card shadow-sm border-0 mb-2 rounded-4 overflow-hidden animate__animated animate__fadeInUp">
  <div class="card-header bg-blue py-3 border-0">
    <h6 class="mb-0 fw-bold text-muted">Equipos del Grupo {{groupName}}</h6>
  </div>
  <div class="card-body p-3">
    {{#if teams}}
    <div class="row g-2 matches-section">
      {{#each teams}}
      <div class="col-6 text-center">
        <img src="/img/flags/{{flag}}" class="flag-img-sm mb-2" alt="{{name}}">
        <div class="small fw-bold text-truncate">{{name}}</div>
      </div>
      {{/each}}
    </div>
    {{else}}
    <div class="text-muted small">No hay equipos para mostrar.</div>
    {{/if}}
  </div>
</div>
