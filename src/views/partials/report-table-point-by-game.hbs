{{#each dataGame}}
<div class="card">
  {{!-- <img src="..." class="card-img-top" alt="..."> --}}
  <div class="card-body game-card-body">
    <h6 class="card-title">Juego número: {{gameNumber}}  &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp &nbsp       {{dateGame}}, {{hourGame}}</h6>
    <div class="game-row">
      <div class="flags-row">
        <img class="flag local-flag" src="/img/flags/{{localFlag}}" alt="flag">
        <img class="flag visit-flag" src="/img/flags/{{visitFlag}}" alt="flag">
      </div>

      <div class="names-row">
        <p class="team-name local-name">{{localTeam}}</p>
        <p class="team-name visit-name">{{visitTeam}}</p>
      </div>

      <div class="scores-row mobile-scores">
        <span class="score local-score">{{localScore}}</span>
        <span class="score analog-score">{{analogScore}}</span>
        <span class="score visit-score">{{visitScore}}</span>
      </div>
    </div>
  </div>
</div>
{{/each}}



<table class="table">
  <thead>
    <tr>
      <th scope="col" style="text-align: center">Jugador</th>
      <th scope="col" style="text-align: center">Local</th>
      <th scope="col" style="text-align: center"></th>
      <th scope="col" style="text-align: center">Visitante</th>
      <th scope="col" style="text-align: center">Pts marcador</th>
      <th scope="col" style="text-align: center">Puntos por L-E-V</th>
      <th scope="col" style="text-align: center; cursor: pointer;" id="sortTotalHeader">
        TOTAL <span id="sortIcon" style="font-size: 0.8em;">⇅</span>
      </th>
    </tr>
  </thead>
  <tbody id="betsBody">
    {{#each dataBet}}
    <tr>
      <td scope="col" style="text-align: center">{{name}}</td>
      <td scope="col" style="text-align: center">{{localScore}}</td>
      <td scope="col" style="text-align: center">{{analogScore}}</td>
      <td scope="col" style="text-align: center">{{visitScore}}</td>
      <td scope="col" style="text-align: center">{{pointByScore}}</td>
      <td scope="col" style="text-align: center">{{pointByAnalogScore}}</td>
      <td scope="col" style="text-align: center">
        {{#if (eq totalByGame 0)}}
          <span style="color: red;">{{totalByGame}}</span>
        {{else if (eq totalByGame 2)}}
          <span style="color: blue; font-size: 1.1em;">{{totalByGame}}</span>
        {{else if (eq totalByGame 3)}}
          <span style="color: blue; font-size: 1.1em;">{{totalByGame}}</span>
        {{else if (eq totalByGame 5)}}
          <span style="color: darkgreen; font-weight: bold; font-size: 1.3em;">{{totalByGame}}</span>
        {{else}}
          {{totalByGame}}
        {{/if}}
      </td>
    </tr>
    {{/each}}
  </tbody>
</table>

<script>
  let isSortedAsc = null; // null = sin ordenar, true = ascendente, false = descendente

  document.getElementById('sortTotalHeader').addEventListener('click', function() {
    const table = this.closest('table');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const sortIcon = document.getElementById('sortIcon');

    // Alternar dirección de ordenamiento antes de ordenar
    if (isSortedAsc === null || isSortedAsc === false) {
      isSortedAsc = true;
      sortIcon.textContent = '▲';
    } else {
      isSortedAsc = false;
      sortIcon.textContent = '▼';
    }

    rows.sort((a, b) => {
      const aCells = a.querySelectorAll('td');
      const bCells = b.querySelectorAll('td');
      const aValue = parseInt(aCells[aCells.length - 1].textContent.trim()) || 0;
      const bValue = parseInt(bCells[bCells.length - 1].textContent.trim()) || 0;
      return isSortedAsc ? aValue - bValue : bValue - aValue;
    });

    rows.forEach(row => tbody.appendChild(row));
  });
</script>

<style>
  /* Mobile-first styles for game card */
  .game-card-body {
    padding: 0.1rem 0.8rem;
  }
  .game-card-body .card-title {
    margin-bottom: 0.1rem;
    font-size: 0.95rem;
  }
  /* Mobile-first: column layout */
  .game-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .flags-row {
    display: flex;
    width: 50%;
    justify-content: space-between;
    gap: 0.35rem;
  }
  .flags-row .flag {
    width: 20%;
    max-width: 100px;
    height: auto;
    object-fit: contain;
  }
  .names-row {
    display: flex;
    width: 100%;
    justify-content: space-between;
    gap: 0.35rem;
  }
  .names-row .team-name {
    width: 60%;
    margin: 0;
    text-align: center;
    font-weight: 600;
    line-height: 1.1;
  }
  .scores-row {
    display: flex;
    width: 100%;
    justify-content: center;
    gap: 2rem;
    margin-top: 0;
  }
  .score {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .analog-score {
    font-size: 1.1rem;
    color: #666;
    margin: 0 0.3rem;
  }

  /* Small screens (mobile) — prioritize mobile view */
  @media (min-width: 577px) {
    /* Mantener estructura vertical en PC, con nombres y resultados debajo de las banderas */
    .game-row {
      flex-direction: column;
      align-items: center;
    }
    .flags-row {
      width: 20%;
      justify-content: center;
      gap: 3rem;
    }
    .flags-row .flag {
      width: 30%;
      max-width: 140px;
    }
    .names-row {
      width: 100%;
      justify-content: space-between;
      gap: 0.75rem;
    }
    .names-row .team-name {
      font-size: 0.95rem;
      width: 48%;
    }
    .scores-row {
      justify-content: center;
      width: 100%;
      gap: 1.5rem;
    }
  }
</style>