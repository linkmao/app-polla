<div class="landing-page">
    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-overlay"></div>
        <div class="container position-relative z-2">
            <div class="row align-items-center min-vh-75 py-5">
                <div class="col-lg-6">
                    <span class="badge bg-primary px-3 py-2 rounded-pill mb-3 text-uppercase tracking-wider">Copa
                        Mundial 2026</span>
                    <h1 class="display-2 fw-bold text-white mb-4 animate-up">Polla Mundialista <span
                            class="text-primary-gradient">2026</span></h1>
                    <p class="lead text-white-50 mb-5 animate-up delay-1">Bienvenidos a la mejor polla para el mundial
                        de Canadá, México y USA. Demuestra que eres el que más sabe de fútbol y disfruta de esta edición
                        del mundial.</p>

                    {{#if viewInitDateTournament}}
                    <div class="tournament-countdown-landing mb-5 animate-up delay-2">
                        <p class="text-white-50 small text-uppercase mb-3 tracking-wider">El mundial comienza en:</p>
                        <div id="tournament-timer" class="d-flex gap-3">
                            <div class="timer-box-landing">
                                <span id="days-t" class="h1 fw-bold text-white d-block mb-0">00</span>
                                <small class="text-white-50 small">Días</small>
                            </div>
                            <div class="timer-box-landing">
                                <span id="hours-t" class="h2 fw-bold text-white d-block mb-0">00</span>
                                <small class="text-white-50 small">Hr</small>
                            </div>
                            <div class="timer-box-landing">
                                <span id="minutes-t" class="h2 fw-bold text-white d-block mb-0">00</span>
                                <small class="text-white-50 small">Min</small>
                            </div>
                            <div class="timer-box-landing">
                                <span id="seconds-t" class="h2 fw-bold text-primary-gradient d-block mb-0">00</span>
                                <small class="text-white-50 small">Seg</small>
                            </div>
                        </div>
                    </div>
                    {{/if}}

                    <div class="d-flex gap-3 animate-up delay-3">
                        <a href="/login" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-lg hover-scale">
                            <i class="fas fa-play-circle me-2"></i>¡Entrar a Jugar!
                        </a>
                        <a href="#reglas" class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill hover-scale">
                            <i class="fas fa-scroll me-2"></i>Ver Reglas
                        </a>
                    </div>
                </div>
                <div class="col-lg-6 d-none d-lg-block">
                    <div class="hero-image-container animate-float">
                        <img src="/img/front/world_cup_hero.png" alt="World Cup Hero"
                            class="img-fluid rounded-4 shadow-2xl">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Reglas Section -->
    <section id="reglas" class="py-5 bg-body-tertiary">
        <div class="container py-5">
            <div class="text-center mb-5">
                <h2 class="display-4 fw-bold mb-3">Bases del Juego</h2>
                <div class="divider mx-auto"></div>
                <p class="text-muted lead mt-3">Todo lo que necesitas saber para participar y ganar.</p>
            </div>

            <div class="row g-4">
                <!-- Ronda de Grupos -->
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden rule-card">
                        <div class="card-header bg-primary text-white p-4 border-0">
                            <h3 class="h4 mb-0"><i class="fas fa-users-cog me-2"></i>Ronda de Grupos</h3>
                        </div>
                        <div class="card-body p-4">
                            <ul class="list-unstyled space-y-4">
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fas fa-dollar-sign"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Inscripción</h5>
                                        <p class="text-muted small">Valor: <strong>$70.000</strong>. Plazo máximo:
                                            Miércoles 10 de junio de 2026.</p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-success-subtle text-success me-3">
                                        <i class="fas fa-bullseye"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Puntos por Partido</h5>
                                        <p class="text-muted small">
                                            <strong>3 puntos</strong> por acertar marcador exacto.<br>
                                            <strong>2 puntos</strong> por acertar ganador (L-E-V).<br>
                                            Acumulables para un máximo de 5 puntos por juego.
                                        </p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-warning-subtle text-warning me-3">
                                        <i class="fas fa-list-ol"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Clasificación de Grupos</h5>
                                        <p class="text-muted small"><strong>5 puntos</strong> por cada equipo acertado
                                            en el orden correcto de su grupo.</p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start">
                                    <div class="icon-box bg-info-subtle text-info me-3">
                                        <i class="fas fa-trophy"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Premiación</h5>
                                        <p class="text-muted small">Se premian los 3 mejores puntajes totales del
                                            torneo.</p>
                                    </div>
                                </li>
                            </ul>
                            <div class="mt-4">
                                <a href="/rules-groups" class="btn btn-outline-primary w-100 rounded-pill">
                                    <i class="fas fa-file-alt me-2"></i>Leer reglas completas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ronda de Fases -->
                <div class="col-lg-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden rule-card">
                        <div class="card-header bg-dark text-white p-4 border-0">
                            <h3 class="h4 mb-0"><i class="fas fa-sitemap me-2"></i>Ronda de Fases Finales</h3>
                        </div>
                        <div class="card-body p-4">
                            <ul class="list-unstyled space-y-4">
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-danger-subtle text-danger me-3">
                                        <i class="fas fa-calendar-check"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Inicio</h5>
                                        <p class="text-muted small">Comienza el 28 de junio de 2026 con los 32 equipos
                                            clasificados reales.</p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-primary-subtle text-primary me-3">
                                        <i class="fas fa-project-diagram"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Dinámica de Llaves</h5>
                                        <p class="text-muted small">Puntos por marcador (3) y ganador (2) en tiempo
                                            reglamentario/extra. No incluyen penales.</p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start mb-3">
                                    <div class="icon-box bg-success-subtle text-success me-3">
                                        <i class="fas fa-check-double"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Puntos por Clasificación</h5>
                                        <p class="text-muted small"><strong>3 puntos</strong> adicionales por cada
                                            equipo que elijas y que avance a la siguiente fase.</p>
                                    </div>
                                </li>
                                <li class="d-flex align-items-start">
                                    <div class="icon-box bg-warning-subtle text-warning me-3">
                                        <i class="fas fa-crown"></i>
                                    </div>
                                    <div>
                                        <h5 class="mb-1">Cuadro de Honor</h5>
                                        <p class="text-muted small"><strong>10 puntos</strong> por cada acierto en los 4
                                            primeros puestos finales (Campéon, Subcampeón, 3ero y 4to).</p>
                                    </div>
                                </li>
                            </ul>
                            <div class="mt-4">
                                <a href="/rules-phases" class="btn btn-outline-dark w-100 rounded-pill">
                                    <i class="fas fa-file-alt me-2"></i>Leer reglas completas
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- More details Button -->
            <div class="text-center mt-5">
                <button class="btn btn-outline-primary rounded-pill px-4" data-bs-toggle="collapse"
                    data-bs-target="#detailedRules">
                    <i class="fas fa-plus-circle me-2"></i>Ver detalles adicionales
                </button>
            </div>

            <div class="collapse mt-4" id="detailedRules">
                <div class="card card-body border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-bold mb-3">Consideraciones Importantes:</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <ul class="small text-muted">
                                <li>En grupos, la apuesta por marcador y L-E-V pueden ser distintas (ej: 2-1 y apostar
                                    Empate).</li>
                                <li>El tercer puesto recibe el valor de su inscripción. El dinero restante se divide:
                                    70% al 1ero y 30% al 2do.</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <ul class="small text-muted">
                                <li>En caso de empate en puntos, los premios se reparten equitativamente.</li>
                                <li>El administrador no se hace responsable por deudas de participantes que no paguen a
                                    tiempo.</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer Landing -->
    <footer class="py-4 bg-dark text-white border-top border-secondary">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start">
                    <p class="mb-0">&copy; 2026 Polla Mundialista. Organizado por Mauricio Rúa Flórez.</p>
                </div>
                <div class="col-md-6 text-center text-md-end mt-3 mt-md-0">
                    <a href="mailto:maolink@gmail.com" class="text-white-50 me-3"><i class="fas fa-envelope me-1"></i>
                        Contactar</a>
                    <a href="tel:3113523313" class="text-white-50"><i class="fas fa-phone me-1"></i> WhatsApp</a>
                </div>
            </div>
        </div>
    </footer>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #0d6efd 0%, #00d2ff 100%);
        --dark-glass: rgba(0, 0, 0, 0.6);
    }

    .landing-page {
        overflow-x: hidden;
    }

    .text-primary-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    /* Hero Styles */
    .hero {
        background: url('/img/front/world_cup_hero.png') center/cover no-repeat;
        position: relative;
        overflow: hidden;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, rgba(10, 10, 20, 0.95) 0%, rgba(10, 10, 20, 0.7) 100%);
        z-index: 1;
    }

    .min-vh-75 {
        min-height: 75vh;
    }

    .hero-image-container {
        padding: 2rem;
        perspective: 1000px;
    }

    .hero-image-container img {
        transform: rotateY(-10deg);
        transition: transform 0.5s ease;
    }

    .hero-image-container:hover img {
        transform: rotateY(0deg);
    }

    /* Animations */
    .animate-up {
        animation: fadeInUp 0.8s ease backwards;
    }

    .delay-1 {
        animation-delay: 0.2s;
    }

    .delay-2 {
        animation-delay: 0.4s;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-float {
        animation: float 6s ease-in-out infinite;
    }

    @keyframes float {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-20px);
        }
    }

    /* Cards & Icons */
    .divider {
        width: 60px;
        height: 4px;
        background: var(--primary-gradient);
        border-radius: 2px;
    }

    .rule-card {
        transition: transform 0.3s ease, shadow 0.3s ease;
    }

    .rule-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.1) !important;
    }

    .icon-box {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .hover-scale:hover {
        transform: scale(1.05);
    }

    .btn-primary {
        background: var(--primary-gradient);
        border: none;
    }

    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .bg-primary-subtle {
        background-color: rgba(13, 110, 253, 0.1);
    }

    .bg-success-subtle {
        background-color: rgba(25, 135, 84, 0.1);
    }

    .bg-warning-subtle {
        background-color: rgba(255, 193, 7, 0.1);
    }

    .bg-info-subtle {
        background-color: rgba(13, 202, 240, 0.1);
    }

    .bg-danger-subtle {
        background-color: rgba(220, 53, 69, 0.1);
    }

    /* Responsive adjustments */
    @media (max-width: 991px) {
        .hero {
            background-position: right center;
        }

        .display-2 {
            font-size: 3rem;
        }
    }

    .timer-box-landing {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        padding: 0.75rem;
        border-radius: 16px;
        min-width: 80px;
        text-align: center;
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease;
    }

    .timer-box-landing:hover {
        transform: translateY(-5px);
        background: rgba(255, 255, 255, 0.1);
    }

    .timer-box-landing span {
        line-height: 1;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const startDateStr = "{{initDateTournament}}";
        const viewFlag = "{{viewInitDateTournament}}";

        if (viewFlag === "true" || viewFlag === true) {
            const targetDate = new Date(startDateStr).getTime();
            const updateTimer = () => {
                const now = new Date().getTime();
                const diff = targetDate - now;
                const timerEl = document.getElementById('tournament-timer');
                if (!timerEl) return;

                if (diff < 0) {
                    timerEl.innerHTML = '<span class="badge bg-success p-3 fs-5">¡El mundial ha comenzado!</span>';
                    return;
                }

                const d = Math.floor(diff / (1000 * 60 * 60 * 24));
                const h = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const m = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const s = Math.floor((diff % (1000 * 60)) / 1000);

                const daysEl = document.getElementById('days-t');
                const hoursEl = document.getElementById('hours-t');
                const minsEl = document.getElementById('minutes-t');
                const secsEl = document.getElementById('seconds-t');

                if (daysEl) daysEl.innerText = String(d).padStart(2, '0');
                if (hoursEl) hoursEl.innerText = String(h).padStart(2, '0');
                if (minsEl) minsEl.innerText = String(m).padStart(2, '0');
                if (secsEl) secsEl.innerText = String(s).padStart(2, '0');
            };
            setInterval(updateTimer, 1000);
            updateTimer();
        }
    });
</script>